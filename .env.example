# Variables de entorno de TuEquipoRD.
#
# En el VPS estas variables NO viven en un archivo .env: las de
# configuración están en deploy/tuequipord.service y los secretos en
# /etc/tuequipord.env con permisos 600. Ver deploy/README.md.
#
# Este archivo es la referencia de qué existe y para qué sirve.

# Firma las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si cambia, todos pierden la sesión. Si se filtra, se pueden falsificar.
TUEQUIPO_SECRETO=

# ── Correo ──────────────────────────────────────────────
#
# Transporte: 'archivo' (desarrollo, escribe en .tmp/correos/) o
# 'brevo' (producción, API HTTPS de correo transaccional).
TUEQUIPO_CORREO=archivo

# Clave de la API de Brevo. Se saca en Brevo → SMTP & API → API Keys.
# Solo hace falta con TUEQUIPO_CORREO=brevo.
BREVO_API_KEY=

# Remitente. Debe estar verificado en Brevo y el dominio necesita SPF,
# DKIM y DMARC publicados, o los correos acaban en spam.
TUEQUIPO_REMITENTE=TuEquipoRD <no-responder@tuequipord.com>

# Buzón interno que recibe las solicitudes de dealer para revisar.
TUEQUIPO_REVISION=dealers@tuequipord.com

# URL pública, para los enlaces que van dentro de los correos.
TUEQUIPO_SITIO=https://tuequipord.com

# Días de antelación del aviso de vencimiento de un anuncio.
TUEQUIPO_DIAS_AVISO=5

# Marca las cookies como Secure. Poner a 1 SOLO con HTTPS ya activo:
# por HTTP el navegador descarta la cookie y no se puede iniciar sesión.
TUEQUIPO_HTTPS=0

# Ruta de la base. Por defecto db/tuequipord.db dentro del proyecto.
# En el VPS conviene sacarla fuera para que un git pull no la toque.
# TUEQUIPO_DB=/var/lib/tuequipord/tuequipord.db

# Puerto del servidor. 8080 por defecto.
PORT=8080

# Fin de la promoción de lanzamiento del plan Estándar (AAAA-MM-DD).
# TUEQUIPO_PROMO_HASTA=2026-12-31

# ── Respaldos ───────────────────────────────────────────
# Carpeta y cuántos conservar. La tarea rota los más antiguos.
# TUEQUIPO_RESPALDOS=/var/backups/tuequipord
# TUEQUIPO_RESPALDOS_MAX=14

# ── Fotografías ─────────────────────────────────────────
# Carpeta donde se guardan. En el VPS, fuera del proyecto para que un
# git pull no las toque y poder respaldarlas aparte.
# TUEQUIPO_FOTOS=/var/lib/tuequipord/fotos
