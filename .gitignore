# Dependencias
node_modules/

# Base de datos local (el esquema vive en db/schema.sql)
db/*.db
db/*.db-shm
db/*.db-wal

# Archivos temporales y de proceso
.tmp/
shots/
correos/

# Capturas de referencia
*.png
*.jpg
*.jpeg
# El paquete de marca se versiona ENTERO. Antes se salvaban a mano dos
# rutas sueltas, y al llegar brand_assets/img/ sus imágenes quedaron
# fuera sin avisar: la vista previa al compartir habría dado 404 en
# producción con todo el HTML apuntando a ella.
!brand_assets/**

# Entorno
.env
.env.*
!.env.example

# Sistema
Thumbs.db
.DS_Store
